{
  "name": "converter",
  "version": "1.0.1",
  "description": "A desktop file conversion tool built with Electron and Node.js.",
  "main": "electron.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": ".\\node_modules\\electron\\dist\\electron.exe .",
    "server": "node server.js",
    "build": "npm run build:full",
    "build:lite": "electron-builder --config electron-builder.lite.json",
    "build:full": "electron-builder --config electron-builder.full.json"
  },
  "keywords": [],
  "author": "Adrastea",
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.adrastea.converter",
    "productName": "Converter",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Converter-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": "false",
      "perMachine": "false",
      "allowToChangeInstallationDirectory": "true",
      "include": "build/installer.nsh"
    },
    "compression": "maximum",
    "extraResources": [
      {
        "from": "build/pdf_to_docx.exe",
        "to": "pdf_to_docx.exe"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sharp/**"
    ],
    "electronLanguages": [
      "en-US",
      "tr"
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!release/**",
      "!uploads/**",
      "!outputs/**",
      "!**/*.map",
      "!**/test{,/**/*}",
      "!**/tests{,/**/*}",
      "!**/docs{,/**/*}",
      "!pdf_to_docx.py"
    ]
  }
}
